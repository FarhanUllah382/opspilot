# Copy this file to .env and fill in real values. Never commit .env.

# LLM provider
LLM_API_KEY=replace-me
LLM_MODEL_CHEAP=replace-me
LLM_MODEL_STRONG=replace-me

# OpsPilot database
OPSPILOT_DB_URL=postgresql://opspilot:opspilot@opspilot-db:5432/opspilot

# ShopLite
SHOP_DB_URL=postgresql://shop:shop@toxiproxy:5433/shop
REDIS_URL=redis://toxiproxy:6380

# Monitoring
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
JAEGER_URL=http://jaeger:16686
